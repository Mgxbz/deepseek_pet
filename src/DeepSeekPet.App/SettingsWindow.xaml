<Window x:Class="DeepSeekPet.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="余宠设置"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF4FFFD">
  <StackPanel Margin="20">
    <TextBlock Text="DeepSeek 桌宠" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
    <TextBlock Margin="0,4,0,14" Foreground="{StaticResource MutedBrush}" Text="密钥只存在本机，并用 Windows DPAPI 加密。"/>

    <TextBlock Text="API Key" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
    <PasswordBox x:Name="ApiKeyBox" Margin="0,6,0,4" Padding="6,7"/>
    <TextBlock x:Name="KeyHint" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="在 platform.deepseek.com 创建密钥后粘贴到这里。"/>

    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="刷新间隔（秒）"/>
        <TextBox x:Name="IntervalBox" Margin="0,6,0,0" Padding="6,6" Text="60"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="低余额阈值"/>
        <TextBox x:Name="ThresholdBox" Margin="0,6,0,0" Padding="6,6" Text="10"/>
      </StackPanel>
    </Grid>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="透明度"/>
        <Slider x:Name="OpacitySlider" Margin="0,8,0,0" Minimum="0.35" Maximum="1" Value="1" TickFrequency="0.05"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="缩放"/>
        <Slider x:Name="ScaleSlider" Margin="0,8,0,0" Minimum="0.7" Maximum="1.6" Value="1" TickFrequency="0.05"/>
      </StackPanel>
    </Grid>

    <DockPanel Margin="0,12,0,0">
      <TextBlock DockPanel.Dock="Top" Text="磁吸距离"/>
      <Slider x:Name="MagnetSlider" Margin="0,8,0,0" Minimum="8" Maximum="80" Value="32"/>
    </DockPanel>

    <CheckBox x:Name="TopmostBox" Margin="0,14,0,0" Content="始终置顶" IsChecked="True"/>
    <CheckBox x:Name="AutoHideBox" Margin="0,8,0,0" Content="贴边停住后自动收起"/>
    <CheckBox x:Name="StartupBox" Margin="0,8,0,0" Content="开机启动"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="取消" Width="84" Padding="0,6" Click="OnCancel"/>
      <Button Content="保存" Width="84" Margin="8,0,0,0" Padding="0,6" Click="OnSave" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
