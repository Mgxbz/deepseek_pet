<UserControl x:Class="DeepSeekPet.App.Character.PetCharacter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="184"
             Height="168"
             Background="Transparent">
  <UserControl.Resources>
    <Storyboard x:Key="BreathStoryboard" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetName="Breath"
                       Storyboard.TargetProperty="Y"
                       From="0" To="-4"
                       Duration="0:0:1.8">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="PokeStoryboard" FillBehavior="Stop">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Squash"
                                     Storyboard.TargetProperty="ScaleX">
        <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.12">
          <EasingDoubleKeyFrame.EasingFunction>
            <QuadraticEase EasingMode="EaseOut"/>
          </EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
        <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="0.94"/>
        <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1">
          <EasingDoubleKeyFrame.EasingFunction>
            <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
          </EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Squash"
                                     Storyboard.TargetProperty="ScaleY">
        <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.86">
          <EasingDoubleKeyFrame.EasingFunction>
            <QuadraticEase EasingMode="EaseOut"/>
          </EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
        <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="1.08"/>
        <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1">
          <EasingDoubleKeyFrame.EasingFunction>
            <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
          </EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
  </UserControl.Resources>

  <Grid RenderTransformOrigin="0.5,1">
    <Grid.RenderTransform>
      <ScaleTransform x:Name="Squash" ScaleX="1" ScaleY="1"/>
    </Grid.RenderTransform>
    <Image x:Name="Sprite"
           Stretch="Uniform"
           RenderOptions.BitmapScalingMode="HighQuality"
           RenderTransformOrigin="0.5,0.5">
      <Image.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="FaceScale" ScaleX="1" ScaleY="1"/>
          <TranslateTransform x:Name="Breath" Y="0"/>
        </TransformGroup>
      </Image.RenderTransform>
    </Image>
  </Grid>
</UserControl>
